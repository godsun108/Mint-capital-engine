    "excludes": [
      "internal_transfer",
      "test_payment",
      "invoice_only",
      "authorized_but_unsettled_payment",
      "free_design_partner"
    ]
  },
  "required_observations": [
    "acquisition_source",
    "price_variant",
    "diagnostic_started_at",
    "diagnostic_completed_at",
    "operator_minutes",
    "direct_cost_usd",
    "customer_payment_status",
    "settled_revenue_usd"
  ],
  "guardrails": {
