{
  "schema": "mint.brand.tokens.v1",
  "structural": {
    "max_content_width_px": 1120,
    "base_spacing_px": 8,
    "radius": [
      "8px",
      "12px",
      "16px"
    ],
    "focus": "visible keyboard focus required",
    "contrast": "customer-facing text/components must target WCAG AA contrast",
    "responsive": "mobile-first"
  },
  "master_mint": {
    "palette": {
      "background": "#07120d",
      "surface": "#0b1a12",
      "text": "#effff5",
      "muted": "#bdd0c5",
      "accent": "#70f0aa",
      "border": "#294438"
    },
    "type": {
      "ui": "system-ui, sans-serif",
      "display": "system-ui, sans-serif"
    },
    "shape": "clean rounded utility",
    "motion": "purposeful and optional; respect reduced-motion preference"
  },
  "inheritance": "STRUCTURE -> OPTIONAL_MASTER -> BRAND -> PRODUCT",
  "rule": "Brand/product tokens may vary creatively but may not remove accessibility or truthful-commerce requirements."
}
